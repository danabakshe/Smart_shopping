# Copy this file to ".env" at the repo root for local development (do NOT commit your real .env)
#
# Server (Gemini)
GEMINI_API_KEY=
# Alternatively:
# GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Rate limiting: Delay between country requests (seconds)
# Free tier: 2 requests/minute = 30 seconds between requests
# Paid tier: Can be lower (e.g., 5-10 seconds)
# Set to 0 to disable (not recommended for free tier)
GEMINI_RATE_LIMIT_DELAY_SECONDS=30

# Optional
DEBUG_DOTENV=0
PRICE_CACHE_TTL_SECONDS=900

# Flask sessions (auth)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET_KEY=


